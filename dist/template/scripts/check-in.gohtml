{{define "check-in-script"}}
<script>
    function postCheckInForm() {
        return {
            student: {
                id: ''
            },
            last_student_id: '',
            modalOpen: false,
            disableForm: false,

            submitData() {
                this.disableForm = true;
                this.last_student_id = this.student.id;

                fetch('/api/check-in', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(this.student)
                })
                .then(resp => {
                    console.log(this.student)
                    if (resp.ok) {
                        toast('Checked In Successfully', {
                            type: 'success',
                            position: 'top-center'
                        });
                    } else if (resp.status === 400) {
                        resp.text().then(text => {
                            if (text === 'student ID does not exist') {
                                this.modalOpen = true;
                            } else if (text === 'already checked in') {
                                toast('You\'re already checked in', {
                                    type: 'danger',
                                    position: 'top-center'
                                });
                            } else if (text === 'your id cant be the same as the pin') {
                                toast('Your student ID can not be the same as the session pin.', {
                                    type: 'danger',
                                    position: 'top-center'
                                });
                            }
                        });
                    } else {
                        console.log(resp);
                    }
                    this.student.id = '';
                })
                .catch(err => {
                    console.log(err);
                }).finally(() => {
                    this.disableForm = false;
                });
            }
        }
    }
</script>
{{end}}